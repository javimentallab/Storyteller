# Entorno del motor (se instala/descarga, no se versiona)
engine/.venv/
engine/.venv-xtts/
engine/.venv-translate/
.venv-tests/
engine/llama.cpp/
engine/__pycache__/
engine/.ready
__pycache__/
*.pyc

# Datos del usuario: descargables desde la app, NO incluidos
# modelos TTS y Whisper (Hugging Face)
models/
# biblioteca narrada / importada
books/
# voces de referencia (clonadas o descargadas por el usuario)
engine/voices/
# configuración local (motor, servidor, voz…), y la que no se pudo leer, apartada
config.json
config.unreadable-*.json
# candado de una sola ventana
.storyteller.lock
# libro apartado mientras se regenera, y el que se trae del servidor antes de ponerlo en su sitio
.regen-*/
.incoming-*/
# servidor de voz: su clave de acceso
server.json
# clave del servicio de voz por URL
service.key
service_qc.key
# traducción: ajustes y progreso guardado
translate.json
translations/
# diccionario de pronunciación del usuario (la semilla está en el código)
pron.json
# muestras de voz locales
muestras_voz/

# actualizaciones: descarga, copia de lo anterior y archivos a medio instalar
.update/

# Audio / EPUB / temporales
*.wav
*.mp3
*.epub
*.tmp
*.log
